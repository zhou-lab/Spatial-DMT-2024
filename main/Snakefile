            --grid-y     {GRID_Y}
        touch {output.plots_done}
        """

# Per-barcode RNA UMI/gene counts and spatial heatmaps from STARsolo output
rule rna_spatial_summary:
    input:
        matrix    = WORKDIR + "/{sample}/rna_STAR/Solo.out/GeneFull/raw/matrix.mtx",
        barcodes  = WORKDIR + "/{sample}/rna_STAR/Solo.out/GeneFull/raw/barcodes.tsv",
        whitelist = RNA_COORD_WHITELIST,
    output:
        spatial_counts = WORKDIR + "/{sample}/qc/table/{sample}_rna_spatial_counts.tsv",
        plots_done     = WORKDIR + "/{sample}/qc/plots/.rna_done",
    resources:
        mem = "8G",
        cpus_per_task = 1,
    shell:
        """
        {PYTHON} {workflow.basedir}/../tools/rna_spatial_summary.py \
            --matrix    {input.matrix} \
            --barcodes  {input.barcodes} \
            --whitelist {input.whitelist} \
            --sample    {wildcards.sample} \
            --table     {output.spatial_counts} \
            --plots-dir {WORKDIR}/{wildcards.sample}/qc/plots/
        touch {output.plots_done}
        """

# MultiQC aggregation + self-contained HTML report
rule qc_report:
    input:
        star_log       = lambda wc: (f"{WORKDIR}/{wc.sample}/rna_STAR/Log.final.out"
                                     if wc.sample in RNA_SAMPLES else []),
        ## Sample-level curated metrics row (custom-content _mqc.tsv with YAML
        ## tooltips; lands in qc/biscuit_qc_merged/, scanned by multiqc below).
        curated_mqc    = WORKDIR + "/{sample}/qc/biscuit_qc_merged/{sample}_curated_metrics_mqc.tsv",
        ## Sample-level biscuit qc on merged BAM (mapq, conv tables -- MultiQC
        ## BISCUIT module picks these up).
        biscuit_qc     = WORKDIR + "/{sample}/qc/biscuit_qc/{sample}_mapq_table.txt",
        spatial_counts = WORKDIR + "/{sample}/qc/table/{sample}_spatial_barcode_counts.tsv",
        trim_stats     = WORKDIR + "/{sample}/trim/{sample}_trim_stats.txt",
        lambda_flagstat = WORKDIR + "/{sample}/bam_lambda/{sample}_Lambda.bam.flagstat",
        cg             = WORKDIR + "/{sample}/pileup/{sample}.cg",
        plots_done     = WORKDIR + "/{sample}/qc/plots/.done",
        ## Unmatched-track diagnostic _mqc, also lands in qc/biscuit_qc_merged/.
        unmatched_summary = WORKDIR + "/{sample}/qc/biscuit_qc_merged/{sample}_unmatched_summary_mqc.tsv",
        unmatched_diagnostics = WORKDIR + "/{sample}/qc/unmatched_diagnostics.tsv",
        diagnostic_rna = diagnostic_rna_inputs,
        report_rna = qc_report_rna_inputs,
    output:
        multiqc      = WORKDIR + "/{sample}/qc/html/multiqc_report.html",
        multiqc_data = directory(WORKDIR + "/{sample}/qc/html/multiqc_report_data"),
        report       = WORKDIR + "/{sample}/qc/html/qc_report.html",
        stats_mqc    = WORKDIR + "/{sample}/qc/table/{sample}_stats_mqc.tsv",
        chromhmm_sum = WORKDIR + "/{sample}/qc/table/{sample}_chromhmm_summary.tsv",
    params:
        diagnostic_rna_args = diagnostic_rna_args,
        report_rna_args = qc_report_rna_args,
    resources:
        mem = "12G",
        cpus_per_task = 4,
    shell:
        """
        mkdir -p {WORKDIR}/{wildcards.sample}/qc/html/
        
        # Explicitly aggregate methylation levels for TssA and Tx
        yame rowop -o musum {input.cg} | \
            yame summary -m {CHROMHMM_CM} - > {output.chromhmm_sum}

        {PYTHON} {workflow.basedir}/../tools/write_stats_mqc.py \
            --trim-stats       {input.trim_stats} \
            --spatial-counts   {input.spatial_counts} \
            --chromhmm-summary {output.chromhmm_sum} \
            --lambda-flagstat  {input.lambda_flagstat} \
            --sample           {wildcards.sample} \
            --output-dir       {WORKDIR}/{wildcards.sample}/qc/table/
        RNA_DIRS=""
        if [[ -n "{input.star_log}" ]]; then
            RNA_DIRS="{WORKDIR}/{wildcards.sample}/rna_STAR/ {WORKDIR}/{wildcards.sample}/rna_bbduk/"
        fi
        {PYTHON} -m multiqc \
            $RNA_DIRS \
            {WORKDIR}/{wildcards.sample}/qc/biscuit_qc/ \
            {WORKDIR}/{wildcards.sample}/qc/biscuit_qc_merged/ \
            {WORKDIR}/{wildcards.sample}/qc/table/ \
            --outdir {WORKDIR}/{wildcards.sample}/qc/html/ \
            --filename multiqc_report.html \
            --force \
            --exclude star \
            --cl-config "sample_names_replace: {{rna_STAR: {wildcards.sample}}}, table_columns_visible: {{biscuit: {{aligned: false}}}}"
        {PYTHON} {workflow.basedir}/../tools/generate_html_report.py \
            --spatial-counts {input.spatial_counts} \
            --plots-dir      {WORKDIR}/{wildcards.sample}/qc/plots/ \
            --sample         {wildcards.sample} \
            --multiqc-html   {output.multiqc} \
            --curated-metrics {input.curated_mqc} \
            --protocol       {PROTOCOL} \
            {params.report_rna_args} \
            --trim-stats            {input.trim_stats} \
            --unmatched-diagnostics {input.unmatched_diagnostics} \
            {params.diagnostic_rna_args} \
            {params.report_rna_args} \
            --output         {output.report}
        """

# Per-barcode mean methylation summarized over genomic features (ChromHMM, windows, chromosomes)
rule spatial_features:
    input:
        cg   = WORKDIR + "/{sample}/pileup/{sample}.cg",
        feat = os.path.join(FEATURE_DIR, "{feat}.bed.gz"),
    output:
        txt = WORKDIR + "/{sample}/qc/features/{feat}.txt.gz",
    resources:
        mem = "80G",
        time = "6:00:00",
        cpus_per_task = 48,
    shell:
        """
        set -xe
        tmp={WORKDIR}/{wildcards.sample}/qc/tmp/features_{wildcards.feat}/
        rm -rf $tmp && mkdir -p $tmp
        cut -f1 {input.cg}.idx | parallel -j {resources.cpus_per_task} \
            'yame subset {input.cg} {{}} | \
                yame summary -q {{}} -m {FEATURE_CM_DIR}/{wildcards.feat}.cm - | \
                gzip -c > '"$tmp"'/{{}}.txt.gz'
        zcat $tmp/*.txt.gz | awk 'NR==1 || $1 != "QFile"' | gzip -c > {output.txt}
        rm -rf $tmp
        """


# QC target: spatial HTML report + MultiQC + feature-level methylation summaries
rule qc:
    input:
        expand(WORKDIR + "/{sample}/qc/html/qc_report.html", sample=SAMPLES),
        expand(WORKDIR + "/{sample}/qc/features/{feat}.txt.gz", sample=SAMPLES, feat=FEATS),

