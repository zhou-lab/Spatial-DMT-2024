## Sample-level BISCUIT-QC on the merged dedup BAM (one invocation per sample,
## not ~9216 per-cell). Emits mapq/strand/dup tables + CpH/CpG retention-by-
## read-position. Does NOT pileup -- conversion table comes from dna_biscuit_
## pileup's already-existing per-cell VCFs (one pileup per cell, not a second
## sample-level one). covdist/cv intentionally not produced -- see
## spatialmeth_qc.sh header note on contig mismatch.
##
## Assumes biscuit >= 1.8 is on PATH (covdist/cv removal aside, the bare
## `biscuit qc` subcommand we depend on landed in 1.8; the conda recipe in
## README pins this). Same for the other biscuit-calling rules in this file.
rule mqc_biscuit:
    input:
        bam = DNA_QC_MERGED_BAM,
    output:
        mapq = WORKDIR + "/{sample}/qc/biscuit_qc/{sample}_mapq_table.txt",
    threads: 2
    resources:
        mem = "12G",
        time = "4:00:00",
        cpus_per_task = threads,
    params:
        ref_fasta = os.path.join(REF_DIR, ref["REF_BASE"], ref["REF_FASTA"]),
        assets    = os.path.join(REF_DIR, ref["REF_BASE"], ref["BISCUIT_QCASSET"]),
        outdir    = WORKDIR + "/{sample}/qc/biscuit_qc",
    shell:
        """
        set -xe
        mkdir -p {params.outdir}

        ## No --vcf arg -> spatialmeth_qc.sh skips the conversion-table awk;
        ## that table is emitted by dna_biscuit_pileup from the per-cell VCFs.
        {workflow.basedir}/../tools/spatialmeth_qc.sh \
            -o {params.outdir} \
            {params.assets} {params.ref_fasta} {wildcards.sample} {input.bam}
        """


## Standard BISCUIT-QC on the unmatched (structure-fail + WL-miss) BAM as ONE
## "sample" -- becomes one entry in MultiQC, parallel to (not mixed with) the
## per-cell mqc_biscuit entries. Sees the whole unmatched bucket lumped together.
rule mqc_unmatched_biscuit:
    input:
        bam = WORKDIR + "/{sample}/bam_unmatched/{sample}_unmatched.bam",
    output:
        flag = WORKDIR + "/{sample}/qc/biscuit_qc_unmatched/.done",
    threads: 4
    resources:
        mem = "16G",
        time = "8:00:00",
        cpus_per_task = threads,
    params:
        ref_fasta = os.path.join(REF_DIR, ref["REF_BASE"], ref["REF_FASTA"]),
        assets    = os.path.join(REF_DIR, ref["REF_BASE"], ref["BISCUIT_QCASSET"]),
    shell:
        """
        set -xeo pipefail
        mkdir -p {WORKDIR}/{wildcards.sample}/qc/biscuit_qc_unmatched/

        QC={workflow.basedir}/../tools/spatialmeth_qc.sh
        $QC -o {WORKDIR}/{wildcards.sample}/qc/biscuit_qc_unmatched/ \
            {params.assets} \
            {params.ref_fasta} \
            {wildcards.sample}_UNMATCHED \
            {input.bam}
        touch {output.flag}
        """


## Diagnose the unmatched bucket directly from R2 FASTQ. Alignment is opt-in:
## set UNMATCHED_DIAGNOSTICS_WITH_BAM=true only when SF/WM genomic mapping and
## duplicate rates are required.
UNMATCHED_DIAGNOSTICS_WITH_BAM = str(
    config.get("UNMATCHED_DIAGNOSTICS_WITH_BAM", "false")
).lower() in {"1", "true", "yes", "on"}

def unmatched_diagnostics_bam(wildcards):
    if not UNMATCHED_DIAGNOSTICS_WITH_BAM:
        return []
    return (
        f"{WORKDIR}/{wildcards.sample}/bam_unmatched/"
        f"{wildcards.sample}_unmatched.bam"
    )

def unmatched_diagnostics_bam_arg(wildcards):
    if not UNMATCHED_DIAGNOSTICS_WITH_BAM:
        return ""
    return (
        f"--bam {WORKDIR}/{wildcards.sample}/bam_unmatched/"
        f"{wildcards.sample}_unmatched.bam"
    )

## Emits two files:
##   - tsv: long-format raw breakdown (section, key, value) for human/scripts
##   - mqc_summary: single MultiQC custom-content table -- per-sample row with
##     SF/WM reads and SF anchor-fail breakdown counts. Mapping fields are
##     included only when UNMATCHED_DIAGNOSTICS_WITH_BAM is enabled.
## The _mqc.tsv lands under qc/biscuit_qc_merged/ which the qc_report rule's
## multiqc invocation scans -- it automatically appears in the report.
rule mqc_unmatched_diagnostics:
    input:
        bam      = unmatched_diagnostics_bam,
        r2_fastq = WORKDIR + "/{sample}/trim/{sample}_Unmatched_R2.fq.gz",
    output:
        tsv         = WORKDIR + "/{sample}/qc/unmatched_diagnostics.tsv",
        mqc_summary = WORKDIR + "/{sample}/qc/biscuit_qc_merged/{sample}_unmatched_summary_mqc.tsv",
    threads: UNMATCHED_DIAGNOSTICS_CPUS
    resources:
        mem = "8G",
        time = config.get("UNMATCHED_DIAGNOSTICS_TIME", "12:00:00"),
        cpus_per_task = threads,
    params:
        bam_arg = unmatched_diagnostics_bam_arg,
    shell:
        """
        set -xeo pipefail
        mkdir -p {WORKDIR}/{wildcards.sample}/qc/biscuit_qc_merged/
        {PYTHON} {workflow.basedir}/../tools/unmatched_diagnostics.py \
            {params.bam_arg} \
            --r2-fastq {input.r2_fastq} \
            --protocol {PROTOCOL} \
            --sample {wildcards.sample} \
            --out {output.tsv} \
            --mqc-summary {output.mqc_summary} \
            --threads {resources.cpus_per_task}
        """

## Sample-level curated metrics table -- the canonical sample-row in MultiQC.
## Pulls from: pre-filter merged BAM flagstat (reads, mapped), the QC BAM
## flagstat (post-bsconv for smcseq), dupsifter.stat (dup_rate),
## sample-level biscuit qc on merged BAM (CA/CC/CT conversion), yame summary on
## {sample}.cg (cpg_coverage, cpg_depth, cpg_meth), lambda align/pileup (lambda
## mapped, lambda methylation retention). Emits a custom-content _mqc.tsv with
## per-column tooltip descriptions (YAML header) that MultiQC picks up under
## qc/biscuit_qc_merged/, alongside the unmatched diagnostic _mqc.
rule mqc_curated:
    input:
        merged_bam       = DNA_QC_MERGED_BAM,
        merged_flagstat  = DNA_QC_MERGED_FLAGSTAT,
        pre_filter_flagstat = WORKDIR + "/{sample}/bam_merged/{sample}_merged_dedup.bam.flagstat",
        merged_dupstat   = WORKDIR + "/{sample}/bam_merged/{sample}_merged_dedup.dupsifter.stat",
        biscuit_conv     = WORKDIR + "/{sample}/qc/biscuit_qc/{sample}_totalBaseConversionRate.txt",
        cg               = WORKDIR + "/{sample}/pileup/{sample}.cg",
        lambda_flagstat  = WORKDIR + "/{sample}/bam_lambda/{sample}_Lambda.bam.flagstat",
        lambda_cg        = WORKDIR + "/{sample}/pileup/{sample}_Lambda.cg",
    output:
        mqc = WORKDIR + "/{sample}/qc/biscuit_qc_merged/{sample}_curated_metrics_mqc.tsv",
    threads: 1
    resources:
        mem = "4G",
        time = "1:00:00",
        cpus_per_task = threads,
    params:
        bsconv_log_arg = lambda wc: (
            f"--bsconv-log {WORKDIR}/{wc.sample}/bam_merged/{wc.sample}.bsconv.log"
            if PROTOCOL == "smcseq"
            else ""
        ),
    shell:
        """
        {PYTHON} {workflow.basedir}/../tools/write_curated_metrics_mqc.py \
            --sample           {wildcards.sample} \
            --merged-flagstat  {input.merged_flagstat} \
            --pre-filter-flagstat {input.pre_filter_flagstat} \
            {params.bsconv_log_arg} \
            --merged-dupstat   {input.merged_dupstat} \
            --biscuit-conv     {input.biscuit_conv} \
            --cg               {input.cg} \
            --lambda-flagstat  {input.lambda_flagstat} \
            --lambda-cg        {input.lambda_cg} \
            --yame             {YAME} \
            --output           {output.mqc}
        """

FEATURE_DIR    = os.path.join(REF_DIR, GENOME_FOR_PATH, "features")
FEATURE_CM_DIR = os.path.join(REF_DIR, GENOME_FOR_PATH, f"KYCGKB_{GENOME_FOR_PATH}")
CHROMHMM_CM    = os.path.join(REF_DIR, ref["REF_BASE"], ref["CHROMHMM_CM"])
if GENOME_FOR_PATH == "hg38":
    FEATS = ["ChromHMM.20220303", "Win100k.20220228", "Chromosome.20221129"]
else:
    FEATS = ["ChromHMM.20220414", "Win100k.20220228", "Win1m.20230709", "Chromosome.20221129"]

