        cg_idx  = WORKDIR + "/{sample}/pileup/{sample}.cg.idx",
        lambda_cg = WORKDIR + "/{sample}/pileup/{sample}_Lambda.cg",
        qc      = WORKDIR + "/{sample}/qc/html/qc_report.html",
