        cg_idx  = OUTDIR + "/{sample}/{sample}.cg.idx",
        lambda_cg = OUTDIR + "/{sample}/{sample}_Lambda.cg",
        qc      = OUTDIR + "/{sample}/qc_report.html",
        multiqc = OUTDIR + "/{sample}/multiqc_report.html",
        multiqc_data = directory(OUTDIR + "/{sample}/multiqc_report_data"),
    shell:
