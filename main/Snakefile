# Resolve the genome-specific ref dict from site.yaml using the 'ref' config key
target_ref = config.get("ref", "")
if target_ref in config:
    ref = config[target_ref]
elif target_ref:
    raise ValueError(f"Genome reference '{target_ref}' not found in genomes.yaml.")
else:
    ref = {}

GENOME = config.get("ref", "unknown")

# Normalize genome to the top-level subdirectory used in REF_DIR
if GENOME.startswith("hg38"):
    GENOME_FOR_PATH = "hg38"
elif GENOME.startswith("mm10"):
    GENOME_FOR_PATH = "mm10"
else:
    raise ValueError(f"Unsupported genome: {GENOME}. Must be hg38 or mm10 based.")

# Configurable I/O roots. Defaults preserve the original cwd-relative behavior.
# Override via --config WORKDIR=... OUTDIR=... FASTQ_DIR=... or set in profile config.
FASTQ_DIR = config.get("FASTQ_DIR", "fastq")
WORKDIR   = config.get("WORKDIR",   "pipeline_output")
OUTDIR    = config.get("OUTDIR",    "final_output")

# Discover samples: explicit IDS list or auto-detect from {FASTQ_DIR}/*/DNA_1.fq* on disk
if "IDS" in config:
    SAMPLES = config["IDS"].split(",")
else:
    DNA_FILES = glob.glob(os.path.join(FASTQ_DIR, "*/DNA_1.fq*"))
    SAMPLES = sorted(list(set([os.path.dirname(f).split(os.sep)[-1] for f in DNA_FILES])))

RNA_SAMPLES = [s for s in SAMPLES if any(
    os.path.exists(os.path.join(FASTQ_DIR, s, f"RNA_1{ext}"))
    for ext in [".fq.gz", ".fq", ".fastq.gz", ".fastq"]
)]
print(f"Detected samples: {SAMPLES} in {FASTQ_DIR}/ ({len(RNA_SAMPLES)} with RNA)")

def require_config(key):
    if key not in config:
        raise ValueError(
            f"Required config key '{key}' is missing. "
            f"Set it in your profile config.yaml or via --config {key}=..."
        )
    return config[key]

REF_DIR      = require_config("REF_DIR")
PYTHON       = require_config("PYTHON")
BARCODES_DIR = os.path.join(workflow.basedir, "..", "barcodes")

## R2 chemistry: spatialdmt (50x50, 8+8bp barcodes — default)
##           or smcseq (96x96, 11+11bp + GGTGTAGTGGGTTTGGAGG primer)
PROTOCOL = config.get("protocol", "spatialdmt")
if PROTOCOL == "smcseq":
    BARCODE_WHITELIST = os.path.join(BARCODES_DIR, "smcseq_barcodes_22mer.txt")
    BARCODE_WL_COL    = 1
    RNA_BARCODE_COMPONENTS = os.path.join(BARCODES_DIR, "smcseq_rna_barcodes_8mer.txt")
    RNA_STAR_WHITELIST = WORKDIR + "/rna_whitelist/smcseq_96x96_singlecol.txt"
    RNA_COORD_WHITELIST = WORKDIR + "/rna_whitelist/smcseq_96x96.tsv"
elif PROTOCOL == "spatialdmt":
    BARCODE_WHITELIST = os.path.join(BARCODES_DIR, "spatial_barcodes.txt")
    BARCODE_WL_COL    = 4
    RNA_BARCODE_COMPONENTS = None
    RNA_STAR_WHITELIST = os.path.join(BARCODES_DIR, "RNA_whitelist_singlecol.txt")
    RNA_COORD_WHITELIST = os.path.join(BARCODES_DIR, "spatial_barcodes.txt")
else:
    raise ValueError(f"Unknown protocol '{PROTOCOL}'. Expected spatialdmt or smcseq.")

def _grid_dims(path):
    """Derive (max X, max Y) from whitelist cols 2 and 3 (1-indexed)."""
    mx = my = 0
    with open(path) as f:
        for line in f:
            parts = line.rstrip("\n").split("\t")
            if len(parts) >= 3 and parts[1].isdigit() and parts[2].isdigit():
                mx = max(mx, int(parts[1]))
                my = max(my, int(parts[2]))
    return mx, my

GRID_X, GRID_Y = _grid_dims(BARCODE_WHITELIST)

# Resolve input fastq path, supporting .fq/.fastq with or without .gz
def get_fastq(wildcards, prefix):
    sample_dir = os.path.join(FASTQ_DIR, wildcards.sample)
    for ext in [".fq.gz", ".fq", ".fastq.gz", ".fastq"]:
        path = os.path.join(sample_dir, prefix + ext)
        if os.path.exists(path):
            return path
    return os.path.join(sample_dir, prefix + ".fq")

def diagnostic_rna_inputs(wildcards):
    if wildcards.sample not in RNA_SAMPLES:
        return []
    sample = wildcards.sample
    return [
        f"{WORKDIR}/{sample}/rna_bbduk/{sample}_stats.primer.txt",
        f"{WORKDIR}/{sample}/rna_bbduk/{sample}_stats.linker1.txt",
        f"{WORKDIR}/{sample}/rna_bbduk/{sample}_stats.linker2.txt",
        f"{WORKDIR}/{sample}/rna_STAR/Solo.out/Barcodes.stats",
    ]

def diagnostic_rna_args(wildcards):
    if wildcards.sample not in RNA_SAMPLES:
        return ""
    sample = wildcards.sample
    return (
        f"--rna-primer-stats {WORKDIR}/{sample}/rna_bbduk/{sample}_stats.primer.txt "
        f"--rna-linker1-stats {WORKDIR}/{sample}/rna_bbduk/{sample}_stats.linker1.txt "
        f"--rna-linker2-stats {WORKDIR}/{sample}/rna_bbduk/{sample}_stats.linker2.txt "
        f"--rna-barcode-stats {WORKDIR}/{sample}/rna_STAR/Solo.out/Barcodes.stats"
    )

def qc_report_rna_inputs(wildcards):
    if wildcards.sample not in RNA_SAMPLES:
        return []
    sample = wildcards.sample
    return [
        f"{WORKDIR}/{sample}/qc/table/{sample}_rna_spatial_counts.tsv",
        f"{WORKDIR}/{sample}/qc/plots/.rna_done",
        f"{WORKDIR}/{sample}/rna_STAR/Solo.out/GeneFull/Summary.csv",
    ]

def qc_report_rna_args(wildcards):
    if wildcards.sample not in RNA_SAMPLES:
        return ""
    sample = wildcards.sample
    return (
        f"--rna-counts {WORKDIR}/{sample}/qc/table/{sample}_rna_spatial_counts.tsv "
        f"--rna-summary {WORKDIR}/{sample}/rna_STAR/Solo.out/GeneFull/Summary.csv"
    )

# Main entry point: run preprocessing, QC, and collect deliverables in {OUTDIR}/
rule final_output:
    input:
        expand(WORKDIR + "/{sample}/pileup/{sample}.cg", sample=SAMPLES),
        expand(WORKDIR + "/{sample}/pileup/{sample}_Lambda.cg", sample=SAMPLES),
        expand(WORKDIR + "/{sample}/rna_STAR/Aligned.out.sam", sample=RNA_SAMPLES),
        expand(WORKDIR + "/{sample}/qc/html/qc_report.html", sample=SAMPLES),
        expand(OUTDIR + "/{sample}/{sample}.cg", sample=SAMPLES),
        expand(OUTDIR + "/{sample}/{sample}.cg.idx", sample=SAMPLES),
        expand(OUTDIR + "/{sample}/{sample}_Lambda.cg", sample=SAMPLES),
        expand(OUTDIR + "/{sample}/qc_report.html", sample=SAMPLES),
        expand(OUTDIR + "/{sample}/multiqc_report.html", sample=SAMPLES),
        expand(OUTDIR + "/{sample}/multiqc_report_data", sample=SAMPLES),
        expand(OUTDIR + "/{sample}/Solo.out", sample=RNA_SAMPLES),

################################################################################
# DNA Pipeline Rules
################################################################################

## Demux-after-align architecture:
##   1. dna_trim_and_tag: rewrite matched read names as <origid>_<XXYY>_<UMI>
##      and emit spatialdmt R1/R2 pairs or clipped smcseq Watson/Crick R1.
##      Structure-fail (_SF)
##      and whitelist-miss (_WM) reads are split off here into a separate
##      Unmatched fastq pair -- they never enter the merged BAM.
##   2. dna_biscuit_align: one biscuit align -9 → dupsifter -B (cell-aware,
##      BS-correct) → samtools sort → split BAM by CB:Z tag into bam/XXYY.bam.
##      Every CB is a real whitelist coord (no sentinel cell).
##   3. dna_biscuit_pileup: per-cell pileup over bam/*.bam; also emits
##      per-cell .conv.tsv (CA/CC/CG/CT beta sum+cnt) pooled to
##      sample-level _totalBaseConversionRate.txt for the curated table.
##
## Unmatched track runs in parallel: dna_biscuit_align_unmatched on the
## separate fastq, mqc_unmatched_biscuit + mqc_unmatched_diagnostics surface
## the bucket as its own MultiQC entry.
##
## Replaces the original demux-before-align path which spawned ~9216 biscuit
## invocations per sample.
DUPSIFTER = config.get("DUPSIFTER", "/mnt/isilon/zhoulab/labbin/dupsifter")
SPLIT_BAM_BY_CB = os.path.join(workflow.basedir, "..", "tools", "split_bam_by_cb.py")
SMCSEQ_BSCONV_ARGS = config.get("SMCSEQ_BSCONV_ARGS", "-m 2")
if PROTOCOL == "smcseq":
    DNA_QC_MERGED_BAM = WORKDIR + "/{sample}/bam_merged/{sample}_merged_dedup.bsconv.bam"
    DNA_QC_MERGED_FLAGSTAT = WORKDIR + "/{sample}/bam_merged/{sample}_merged_dedup.bsconv.bam.flagstat"
else:
    DNA_QC_MERGED_BAM = WORKDIR + "/{sample}/bam_merged/{sample}_merged_dedup.bam"
    DNA_QC_MERGED_FLAGSTAT = WORKDIR + "/{sample}/bam_merged/{sample}_merged_dedup.bam.flagstat"

## Lambda fastq outputs only exist for spatialdmt -- smcseq has no dedicated
## lambda barcode, so spatialmeth_trimtag.py doesn't write per-chunk Lambda
## fastqs and the cat block is skipped (see _LAMBDA_CAT_BLOCK below).
_TRIM_LAMBDA_OUTS = {}
_LAMBDA_CAT_BLOCK = ""
_TRIM_MATCHED_OUTS = {}
_MATCHED_CAT_BLOCK = ""
if PROTOCOL == "spatialdmt":
    _TRIM_MATCHED_OUTS = {
        "r1_out": WORKDIR + "/{sample}/trim/{sample}_R1.fq.gz",
        "r2_out": WORKDIR + "/{sample}/trim/{sample}_R2.fq.gz",
    }
    _MATCHED_CAT_BLOCK = """
        :> {output.r1_out}; :> {output.r2_out}
        for f in $(/bin/ls {WORKDIR}/{wildcards.sample}/tmp/trim/_out_[0-9][0-9][0-9][0-9]_R1.fq.gz | sort -V); do
            cat "$f" >> {output.r1_out}
            cat "${{f%_R1.fq.gz}}_R2.fq.gz" >> {output.r2_out}
        done"""
    _TRIM_LAMBDA_OUTS = {
        "lambda_r1": WORKDIR + "/{sample}/trim/{sample}_Lambda_R1.fq.gz",
        "lambda_r2": WORKDIR + "/{sample}/trim/{sample}_Lambda_R2.fq.gz",
    }
    _LAMBDA_CAT_BLOCK = """
        :> {output.lambda_r1}; :> {output.lambda_r2}
        for f in $(/bin/ls {WORKDIR}/{wildcards.sample}/tmp/trim/_out_*_Lambda_R1.fq.gz | sort -V); do
            cat "$f" >> {output.lambda_r1}
            cat "${{f%_Lambda_R1.fq.gz}}_Lambda_R2.fq.gz" >> {output.lambda_r2}
        done"""
else:
    _TRIM_MATCHED_OUTS = {
        "watson_r1": WORKDIR + "/{sample}/trim/{sample}_Watson_R1.fq.gz",
        "crick_r1": WORKDIR + "/{sample}/trim/{sample}_Crick_R1.fq.gz",
    }
    _MATCHED_CAT_BLOCK = """
        :> {output.watson_r1}; :> {output.crick_r1}
        for f in $(/bin/ls {WORKDIR}/{wildcards.sample}/tmp/trim/_out_*_Watson_R1.fq.gz | sort -V); do
            cat "$f" >> {output.watson_r1}
            cat "${{f%_Watson_R1.fq.gz}}_Crick_R1.fq.gz" >> {output.crick_r1}
        done"""

rule dna_trim_and_tag:
    input:
        r1 = lambda wildcards: get_fastq(wildcards, "DNA_1"),
        r2 = lambda wildcards: get_fastq(wildcards, "DNA_2"),
        wl = BARCODE_WHITELIST,
    output:
        unmatched_r1   = WORKDIR + "/{sample}/trim/{sample}_Unmatched_R1.fq.gz",
        unmatched_r2   = WORKDIR + "/{sample}/trim/{sample}_Unmatched_R2.fq.gz",
        stats          = WORKDIR + "/{sample}/trim/{sample}_trim_stats.txt",
        **_TRIM_MATCHED_OUTS,
        **_TRIM_LAMBDA_OUTS,
    resources:
        mem = "90G",
        time = "120:00:00",
        cpus_per_task = 48,
    shell:
        """
        set -xeo pipefail
        mkdir -p {WORKDIR}/{wildcards.sample}/trim/ \
                 {WORKDIR}/{wildcards.sample}/tmp/trim/

        CAT_CMD1="cat"
        if [[ {input.r1} == *.gz ]]; then CAT_CMD1="pigz -dc"; fi
        CAT_CMD2="cat"
        if [[ {input.r2} == *.gz ]]; then CAT_CMD2="pigz -dc"; fi

        $CAT_CMD1 {input.r1} | split -d -a 4 -l 40000000 - {WORKDIR}/{wildcards.sample}/tmp/trim/_chunk_1
        $CAT_CMD2 {input.r2} | split -d -a 4 -l 40000000 - {WORKDIR}/{wildcards.sample}/tmp/trim/_chunk_2

        parallel --halt soon,fail=1 -j {resources.cpus_per_task} '
            f={{}}; b=$(basename "$f"); cid=${{b#_chunk_1}}
            d=$(dirname "$f"); f2="$d/_chunk_2$cid"
            {PYTHON} {workflow.basedir}/../tools/spatialmeth_trimtag.py \
                "$f" "$f2" \
                -o {WORKDIR}/{wildcards.sample}/tmp/trim/_out_"$cid" \
                -a CTATCTCTTATA AGATGCGAGAAGCCAACGCTTG \
                    AATCATACACCAATACAAAACATCAACCAC \
                    CAAATACTCTAACCTCTCAAACACATAAAT \
                --protocol {PROTOCOL} \
                --whitelist {input.wl} \
                --whitelist_col {BARCODE_WL_COL} \
                --bc-mismatch 1
        ' ::: {WORKDIR}/{wildcards.sample}/tmp/trim/_chunk_1*

        ## Cat per-chunk gzipped outputs (gzip concat is valid; readers stream through)
        :> {output.unmatched_r1}; :> {output.unmatched_r2}
        for f in $(/bin/ls {WORKDIR}/{wildcards.sample}/tmp/trim/_out_*_Unmatched_R1.fq.gz | sort -V); do
            cat "$f" >> {output.unmatched_r1}
            cat "${{f%_Unmatched_R1.fq.gz}}_Unmatched_R2.fq.gz" >> {output.unmatched_r2}
        done""" + _MATCHED_CAT_BLOCK + _LAMBDA_CAT_BLOCK + """

        ## Sum per-chunk stats fieldwise
        awk '{{cnt[$1]+=$2}} END {{
            for (k in cnt) print k"\t"cnt[k]
        }}' {WORKDIR}/{wildcards.sample}/tmp/trim/_out_*_stats.txt \
            | sort -k1,1 > {output.stats}
        """

## One biscuit align call (with -9 to parse <origid>_<XXYY>_<UMI> into CB:Z+RX:Z),
## piped through tag-aware dupsifter -B, sorted by coord, then split into per-cell
## BAMs keyed on CB:Z. Replaces the 9216-cell-per-sample alignment loop.
if PROTOCOL == "smcseq":
    _DNA_ALIGN_INPUTS = {
        "watson_r1": WORKDIR + "/{sample}/trim/{sample}_Watson_R1.fq.gz",
        "crick_r1": WORKDIR + "/{sample}/trim/{sample}_Crick_R1.fq.gz",
    }
    _DNA_ALIGN_COMMAND = """
        {{
            biscuit align {params.biscuit_index} -b 1 -9 -@ {resources.cpus_per_task} {input.watson_r1}
            biscuit align {params.biscuit_index} -b 3 -9 -@ {resources.cpus_per_task} {input.crick_r1} | samtools view
        }}"""
    _DNA_ALIGN_EXTRA_OUTS = {}
    _DNA_SPLIT_BLOCK = ""
    _DNA_DUPSIFTER_MODE = "-s"
else:
    _DNA_ALIGN_INPUTS = {
        "r1": WORKDIR + "/{sample}/trim/{sample}_R1.fq.gz",
        "r2": WORKDIR + "/{sample}/trim/{sample}_R2.fq.gz",
    }
    _DNA_ALIGN_COMMAND = """
        biscuit align {params.biscuit_index} -b 1 -9 -@ {resources.cpus_per_task} \
            {input.r2} {input.r1}"""
    _DNA_ALIGN_EXTRA_OUTS = {
        "align_txt": WORKDIR + "/{sample}/align_list.txt",
    }
    _DNA_SPLIT_BLOCK = """
        {PYTHON} {SPLIT_BAM_BY_CB} {output.merged_bam} {WORKDIR}/{wildcards.sample}/bam/ --threads 2
        find {WORKDIR}/{wildcards.sample}/bam/ -maxdepth 1 -name '[0-9][0-9][0-9][0-9].bam' \
            | parallel -j {resources.cpus_per_task} samtools index
        find {WORKDIR}/{wildcards.sample}/bam/ -maxdepth 1 -name '[0-9][0-9][0-9][0-9].bam' \
            -printf '%f\\n' | sed 's/\\.bam$//' | sort > {output.align_txt}"""
    _DNA_DUPSIFTER_MODE = ""

rule dna_biscuit_align:
    input:
        **_DNA_ALIGN_INPUTS,
    output:
        merged_bam = WORKDIR + "/{sample}/bam_merged/{sample}_merged_dedup.bam",
        merged_bai = WORKDIR + "/{sample}/bam_merged/{sample}_merged_dedup.bam.bai",
        merged_flagstat = WORKDIR + "/{sample}/bam_merged/{sample}_merged_dedup.bam.flagstat",
        dup_stats = WORKDIR + "/{sample}/bam_merged/{sample}_merged_dedup.dupsifter.stat",
        **_DNA_ALIGN_EXTRA_OUTS,
    resources:
        mem = "160G",
        time = "96:00:00",
        cpus_per_task = 48,
    params:
        biscuit_index = os.path.join(REF_DIR, ref["REF_BASE"], ref["BISCUIT_INDEX"]),
        ref_fasta     = os.path.join(REF_DIR, ref["REF_BASE"], ref["REF_FASTA"]),
    shell:
        """
        set -xeo pipefail
        ulimit -n 65535
        mkdir -p {WORKDIR}/{wildcards.sample}/bam/ \
                 {WORKDIR}/{wildcards.sample}/bam_merged/

        ## biscuit -9 parses <origid>_<CB>_<UMI> -> emits CB:Z + RX:Z tags (CB is
        ## an 8-char ACGT encoding of the spatial coord; see spatialmeth_trimtag.py).
        ## dupsifter -B uses CB for per-cell dedup signatures (BS-correct +
        ## cell-aware).
        ## SmC-seq follows the published method: clipped R1 only, Watson in
        ## parent orientation and Crick in daughter/PBAT-equivalent orientation.
        """ + _DNA_ALIGN_COMMAND + """ \
        | {DUPSIFTER} """ + _DNA_DUPSIFTER_MODE + """ -B --stats-output {output.dup_stats} {params.ref_fasta} - \
        | samtools sort -@ 24 -T {output.merged_bam}_tmp -O bam -o {output.merged_bam} -
        samtools index {output.merged_bam}
        samtools flagstat {output.merged_bam} > {output.merged_flagstat}
        """ + _DNA_SPLIT_BLOCK + """
        """

if PROTOCOL == "smcseq":
    rule dna_bsconv_filter:
        input:
            bam = WORKDIR + "/{sample}/bam_merged/{sample}_merged_dedup.bam",
            bai = WORKDIR + "/{sample}/bam_merged/{sample}_merged_dedup.bam.bai",
        output:
            filtered_bam = WORKDIR + "/{sample}/bam_merged/{sample}_merged_dedup.bsconv.bam",
            filtered_bai = WORKDIR + "/{sample}/bam_merged/{sample}_merged_dedup.bsconv.bam.bai",
            filtered_flagstat = WORKDIR + "/{sample}/bam_merged/{sample}_merged_dedup.bsconv.bam.flagstat",
            bsconv_stats = WORKDIR + "/{sample}/bam_merged/{sample}.bsconv.log",
            align_txt = WORKDIR + "/{sample}/align_list.txt",
        resources:
            mem = "80G",
            time = "48:00:00",
            cpus_per_task = 24,
        params:
            ref_fasta = os.path.join(REF_DIR, ref["REF_BASE"], ref["REF_FASTA"]),
            bsconv_args = SMCSEQ_BSCONV_ARGS,
        shell:
            """
            set -xeo pipefail
            rm -rf {WORKDIR}/{wildcards.sample}/bam/
            mkdir -p {WORKDIR}/{wildcards.sample}/bam/

            ## Default -m 2 removes reads with >=3 retained CpH calls. CpG
            ## retention is not included in this filter.
            biscuit bsconv {params.bsconv_args} {params.ref_fasta} {input.bam} {output.filtered_bam} \
                2> {output.bsconv_stats}
            samtools index {output.filtered_bam}
            samtools flagstat {output.filtered_bam} > {output.filtered_flagstat}

            {PYTHON} {SPLIT_BAM_BY_CB} {output.filtered_bam} {WORKDIR}/{wildcards.sample}/bam/ --threads 2
            find {WORKDIR}/{wildcards.sample}/bam/ -maxdepth 1 -name '[0-9][0-9][0-9][0-9].bam' \
                | parallel -j {resources.cpus_per_task} samtools index
            find {WORKDIR}/{wildcards.sample}/bam/ -maxdepth 1 -name '[0-9][0-9][0-9][0-9].bam' \
                -printf '%f\\n' | sed 's/\\.bam$//' | sort > {output.align_txt}
            """

# CpG methylation pileup: call methylation per barcode BAM, convert VCF to CpG BED,
# merge strands, intersect with reference CpG BED, and pack into yame .cg format.
rule dna_biscuit_pileup:
    input:
        align_txt = WORKDIR + "/{sample}/align_list.txt",
    output:
        cg        = WORKDIR + "/{sample}/pileup/{sample}.cg",
        idx       = WORKDIR + "/{sample}/pileup/{sample}.cg.idx",
        ## Sample-aggregate CA/CC/CG/CT retention extracted from the SAME
        ## per-cell VCFs we generate for the .cg above -- no second pileup
        ## anywhere. mqc_curated consumes this directly; it replaces
        ## a separate feature_CH / Dinuc-bed intersection pass.
        conv_rate = WORKDIR + "/{sample}/qc/biscuit_qc/{sample}_totalBaseConversionRate.txt",
    resources:
        mem = "80G",
        time = "48:00:00",
        cpus_per_task = 48,
    params:
        ref_fasta = os.path.join(REF_DIR, ref["REF_BASE"], ref["REF_FASTA"]),
        cpg_bed   = os.path.join(REF_DIR, ref["REF_BASE"], ref["CPG_BED"]),
        pileup_threads_per_cell = int(config.get("PILEUP_THREADS_PER_CELL", 4)),
    shell:
        """
        set -xeo pipefail
        mkdir -p {WORKDIR}/{wildcards.sample}/pileup/ \
                 {WORKDIR}/{wildcards.sample}/qc/biscuit_qc/
        tmp_pileup={WORKDIR}/{wildcards.sample}/tmp/pileup/
        mkdir -p $tmp_pileup
        pileup_threads={params.pileup_threads_per_cell}
        pileup_jobs=$(( {resources.cpus_per_task} / pileup_threads ))
        if [[ $pileup_jobs -lt 1 ]]; then pileup_jobs=1; fi

        export tmp_pileup pileup_threads
        find {WORKDIR}/{wildcards.sample}/bam/ -maxdepth 1 -name '*.bam' -type f | sort | \
            parallel --halt soon,fail=1 -j "$pileup_jobs" '
                bam={{}}
                barcode=$(basename "$bam" .bam)
                out_vcf="$tmp_pileup/$barcode.vcf.gz"
                biscuit pileup -m 0 -a 0 -c -u -p -@ "$pileup_threads" {params.ref_fasta} "$bam" | \
                    bgzip -c > "$out_vcf"
                tabix -p vcf "$out_vcf"
            '

        ## Per-cell processing: emit the cell's .cg AND its CA/CC/CG/CT
        ## conversion summary (context\\tbeta_sum\\tbeta_cnt) in one parallel
        ## pass. The .conv.tsv files stay on disk under tmp/pileup/ -- usable
        ## by future per-cell spatial-conversion heatmaps without re-pileup.
        process_cell() {{
            local vcf=$1 base
            base=$(basename "$vcf" .vcf.gz)
            biscuit vcf2bed -k 1 -t cg "$vcf" | cut -f1-5 | \
                LC_ALL=C sort -k1,1 -k2,2n | \
                biscuit mergecg {params.ref_fasta} - | \
                bedtools intersect -a {params.cpg_bed} -b - -sorted -loj | \
                awk -v OFS="\\t" -F"\\t" -f {workflow.basedir}/../tools/wanding.awk \
                    -e '{{ M=round($7*$8); print M,$8-M;}}' | \
                yame pack -f 3 - > "$(dirname $vcf)/$base.cg"
            biscuit vcf2bed -e -t c "$vcf" | \
                awk -F"\\t" -v out="$(dirname $vcf)/$base.conv.tsv" '
                    {{ sum[$6] += $8; cnt[$6] += 1 }}
                    END {{
                        for (c in sum) printf "%s\\t%.6f\\t%d\\n", c, sum[c], cnt[c] > out
                    }}'
        }}
        export -f process_cell
        parallel -j {resources.cpus_per_task} \
            'process_cell {{}}' ::: $tmp_pileup/*.vcf.gz

        :>{output.cg}
        for cg_file in $tmp_pileup/*.cg; do
            barcode=$(basename $cg_file .cg)
            cat $cg_file >> {output.cg}
            yame index -1 $barcode {output.cg}
        done

        ## Sample-level CA/CC/CG/CT = record-pooled mean across per-cell
        ## conversion files (each cell contributed beta_sum + beta_cnt above;
        ## pooling sums then dividing = each record weighted equally, which
        ## is the same denominator the upstream QC.sh awk uses).
        {{
            echo "BISCUITqc Conversion Rate by Base Average Table"
            echo -e "CA\\tCC\\tCG\\tCT"
            cat $tmp_pileup/*.conv.tsv | awk -F"\\t" '
                {{ sum[$1] += $2; cnt[$1] += $3 }}
                END {{
                    for (c in sum) m[c] = (cnt[c] >= 20) ? sum[c]/cnt[c] : -1
                    printf "%g\\t%g\\t%g\\t%g\\n",
                        (("CA" in m)?m["CA"]:-1), (("CC" in m)?m["CC"]:-1),
                        (("CG" in m)?m["CG"]:-1), (("CT" in m)?m["CT"]:-1)
                }}'
        }} > {output.conv_rate}
        """

# Lambda spike-in: alignment and pileup for bisulfite conversion efficiency estimation.
_lambda_ref      = config["Lambda"]
LAMBDA_REF_FASTA     = os.path.join(REF_DIR, _lambda_ref["REF_BASE"], _lambda_ref["REF_FASTA"])
LAMBDA_BISCUIT_INDEX = os.path.join(REF_DIR, _lambda_ref["REF_BASE"], _lambda_ref["BISCUIT_INDEX"])
LAMBDA_CPG_BED       = os.path.join(REF_DIR, _lambda_ref["REF_BASE"], _lambda_ref["CPG_BED"])

## Lambda alignment inputs depend on protocol:
##   spatialdmt: dedicated barcode-85 reads only (trim/{sample}_Lambda_R{1,2}).
##   smcseq:     no dedicated lambda barcode (Liu repo: zero hits for
##               lambda/J02459/spike-in). Align the FULL tagged fastq to the
##               lambda genome -- any actual spike-in reads will map; mouse
##               reads will mostly fail to map.
if PROTOCOL == "smcseq":
    _LAMBDA_ALIGN_INPUTS = {
        "watson_r1": WORKDIR + "/{sample}/trim/{sample}_Watson_R1.fq.gz",
        "crick_r1": WORKDIR + "/{sample}/trim/{sample}_Crick_R1.fq.gz",
    }
    _LAMBDA_ALIGN_COMMAND = """
        {{
            biscuit align {LAMBDA_BISCUIT_INDEX} -b 1 -@ {resources.cpus_per_task} {input.watson_r1}
            biscuit align {LAMBDA_BISCUIT_INDEX} -b 3 -@ {resources.cpus_per_task} {input.crick_r1} | samtools view
        }}"""
    _LAMBDA_DUPSIFTER_MODE = "-s"
else:
    _LAMBDA_ALIGN_INPUTS = {
        "r1": WORKDIR + "/{sample}/trim/{sample}_Lambda_R1.fq.gz",
        "r2": WORKDIR + "/{sample}/trim/{sample}_Lambda_R2.fq.gz",
    }
    _LAMBDA_ALIGN_COMMAND = """
        biscuit align {LAMBDA_BISCUIT_INDEX} -b 1 -@ {resources.cpus_per_task} {input.r2} {input.r1}"""
    _LAMBDA_DUPSIFTER_MODE = ""

rule dna_biscuit_align_lambda:
    input:
        **_LAMBDA_ALIGN_INPUTS,
    output:
        bam      = WORKDIR + "/{sample}/bam_lambda/{sample}_Lambda.bam",
        bai      = WORKDIR + "/{sample}/bam_lambda/{sample}_Lambda.bam.bai",
        flagstat = WORKDIR + "/{sample}/bam_lambda/{sample}_Lambda.bam.flagstat",
        dup      = WORKDIR + "/{sample}/bam_lambda/{sample}_Lambda.dupsifter.stat",
    resources:
        mem = "54G",
        time = "24:00:00",
        cpus_per_task = 48,
    shell:
        """
        set -xe
        mkdir -p {WORKDIR}/{wildcards.sample}/bam_lambda/
        """ + _LAMBDA_ALIGN_COMMAND + """ | \
            dupsifter """ + _LAMBDA_DUPSIFTER_MODE + """ --stats-output {output.dup} {LAMBDA_REF_FASTA} | \
            samtools sort -@ 24 -T {output.bam}_tmp -O bam -o {output.bam}
        samtools index {output.bam}
        samtools flagstat {output.bam} > {output.flagstat}
        """

# CpG and non-CpG pileup on lambda BAM; allc.bed enables conversion efficiency calculation.
rule dna_biscuit_pileup_lambda:
    input:
        bam = WORKDIR + "/{sample}/bam_lambda/{sample}_Lambda.bam",
        bai = WORKDIR + "/{sample}/bam_lambda/{sample}_Lambda.bam.bai",
    output:
        vcf  = WORKDIR + "/{sample}/tmp/pileup_lambda/{sample}_Lambda.vcf.gz",
        tbi  = WORKDIR + "/{sample}/tmp/pileup_lambda/{sample}_Lambda.vcf.gz.tbi",
        allc = WORKDIR + "/{sample}/tmp/pileup_lambda/{sample}_Lambda_allc.bed",
        cg   = WORKDIR + "/{sample}/pileup/{sample}_Lambda.cg",
    resources:
        mem = "20G",
        time = "24:00:00",
        cpus_per_task = 4,
    shell:
        """
        set -xe
        mkdir -p {WORKDIR}/{wildcards.sample}/tmp/pileup_lambda/ \
                 {WORKDIR}/{wildcards.sample}/pileup/
        biscuit pileup -m 0 -a 0 -c -u -p -@ {resources.cpus_per_task} {LAMBDA_REF_FASTA} {input.bam} | \
            bgzip -c > {output.vcf}
        tabix -p vcf {output.vcf}
        biscuit vcf2bed -t c  -c {output.vcf} > {output.allc}
        biscuit vcf2bed -k 1 -t cg {output.vcf} | cut -f1-5 | \
            LC_ALL=C sort -k1,1 -k2,2n | \
            biscuit mergecg {LAMBDA_REF_FASTA} - | \
            bedtools intersect -a {LAMBDA_CPG_BED} -b - -sorted -loj | \
            awk -v OFS="\\t" -F"\\t" -f {workflow.basedir}/../tools/wanding.awk \
                -e '{{ M=round($7*$8); print M,$8-M;}}' | \
            yame pack -f 3 - > {output.cg}
        """

## Unmatched-track alignment: structure-pass + whitelist-miss reads from
## dna_trim_and_tag. Aligned to the same genome but without -9 (no CB tag in
## read names) and without -B (no per-cell dedup; position-based dedup is the
## right level here -- every read is from the "fake" UNMATCHED cell anyway).
## Output is a single sample-level BAM that mqc_unmatched_biscuit can summarize.
rule dna_biscuit_align_unmatched:
    input:
        r1 = WORKDIR + "/{sample}/trim/{sample}_Unmatched_R1.fq.gz",
        r2 = WORKDIR + "/{sample}/trim/{sample}_Unmatched_R2.fq.gz",
    output:
        bam      = WORKDIR + "/{sample}/bam_unmatched/{sample}_unmatched.bam",
        bai      = WORKDIR + "/{sample}/bam_unmatched/{sample}_unmatched.bam.bai",
        flagstat = WORKDIR + "/{sample}/bam_unmatched/{sample}_unmatched.bam.flagstat",
        dup      = WORKDIR + "/{sample}/bam_unmatched/{sample}_unmatched.dupsifter.stat",
    resources:
        mem = "120G",
        time = "48:00:00",
        cpus_per_task = 24,
    params:
        biscuit_index = os.path.join(REF_DIR, ref["REF_BASE"], ref["BISCUIT_INDEX"]),
        ref_fasta     = os.path.join(REF_DIR, ref["REF_BASE"], ref["REF_FASTA"]),
    shell:
        """
        set -xeo pipefail
        mkdir -p {WORKDIR}/{wildcards.sample}/bam_unmatched/
        biscuit align {params.biscuit_index} -b 1 -@ {resources.cpus_per_task} \
            {input.r2} {input.r1} \
        | {DUPSIFTER} --stats-output {output.dup} {params.ref_fasta} - \
        | samtools sort -@ 24 -T {output.bam}_tmp -O bam -o {output.bam} -
        samtools index {output.bam}
        samtools flagstat {output.bam} > {output.flagstat}
        """

################################################################################
# RNA Pipeline Rules
################################################################################

bbduk        = require_config("BBDUK")
STAR_REF_DIR = os.path.join(REF_DIR, GENOME_FOR_PATH, "STAR")

if PROTOCOL == "smcseq":
    rule smcseq_rna_whitelists:
        input:
            RNA_BARCODE_COMPONENTS,
        output:
            star = RNA_STAR_WHITELIST,
            coordinates = RNA_COORD_WHITELIST,
        shell:
            """
            {PYTHON} {workflow.basedir}/../tools/write_rna_whitelist.py \
                --barcodes             {input} \
                --star-whitelist       {output.star} \
                --coordinate-whitelist {output.coordinates}
            """

    # LiuLab spatial-RNA grammar: 1 bp + motif + 8 bp BC1 + motif + 8 bp BC2
    # + motif + 10 bp UMI. The leading 1 bp UMI is discarded by their ST path.
    rule rna_fq_process:
        input:
            r1 = lambda wildcards: get_fastq(wildcards, "RNA_1"),
            r2 = lambda wildcards: get_fastq(wildcards, "RNA_2"),
        output:
            read_seq = WORKDIR + "/{sample}/tmp/rna_processed/{sample}_R1_filtered_linker2.fastq",
            read_bc = WORKDIR + "/{sample}/tmp/rna_processed/{sample}_R2_processed.fastq",
            primer_stats = WORKDIR + "/{sample}/rna_bbduk/{sample}_stats.primer.txt",
            linker1_stats = WORKDIR + "/{sample}/rna_bbduk/{sample}_stats.linker1.txt",
            linker2_stats = WORKDIR + "/{sample}/rna_bbduk/{sample}_stats.linker2.txt",
        resources:
            mem = "20G",
            time = "12:00:00",
            cpus_per_task = 1,
        shell:
            """
            {PYTHON} {workflow.basedir}/../tools/smcseq_rna_process.py \
                --r1              {input.r1} \
                --r2              {input.r2} \
                --read-seq-output {output.read_seq} \
                --barcode-output  {output.read_bc} \
                --primer-stats    {output.primer_stats} \
                --linker1-stats   {output.linker1_stats} \
                --linker2-stats   {output.linker2_stats}
            """
else:
    # Keep only R2 reads that contain the spatial primer sequence.
    rule rna_filter_primer:
        input:
            in1 = lambda wildcards: get_fastq(wildcards, "RNA_1"),
            in2 = lambda wildcards: get_fastq(wildcards, "RNA_2"),
        output:
            out1 = WORKDIR + "/{sample}/tmp/rna_processed/{sample}_R1_filtered_primer.fastq.gz",
            out2 = WORKDIR + "/{sample}/tmp/rna_processed/{sample}_R2_filtered_primer.fastq.gz",
        resources:
            mem = "20G",
            time = "12:00:00",
            cpus_per_task = 12,
        shell:
            """
            mkdir -p {WORKDIR}/{wildcards.sample}/tmp/rna_processed/ \
                     {WORKDIR}/{wildcards.sample}/rna_bbduk/
            {bbduk} \
            in1={input.in1} in2={input.in2} \
            outm1={output.out1} outm2={output.out2} \
            k=22 mm=f rcomp=f restrictleft=30 skipr1=t hdist=2 \
            stats={WORKDIR}/{wildcards.sample}/rna_bbduk/{wildcards.sample}_stats.primer.txt \
            threads={resources.cpus_per_task} \
            literal=CAAGCGTTGGCTTCTCGCATCT
            """

    rule rna_filter_L1:
        input:
            in1 = WORKDIR + "/{sample}/tmp/rna_processed/{sample}_R1_filtered_primer.fastq.gz",
            in2 = WORKDIR + "/{sample}/tmp/rna_processed/{sample}_R2_filtered_primer.fastq.gz",
        output:
            out1 = WORKDIR + "/{sample}/tmp/rna_processed/{sample}_R1_filtered_linker1.fastq.gz",
            out2 = WORKDIR + "/{sample}/tmp/rna_processed/{sample}_R2_filtered_linker1.fastq.gz",
        resources:
            mem = "20G",
            time = "12:00:00",
            cpus_per_task = 12,
        shell:
            """
            {bbduk} \
            in1={input.in1} in2={input.in2} \
            outm1={output.out1} outm2={output.out2} \
            k=30 mm=f rcomp=f restrictleft=108 skipr1=t hdist=3 \
            stats={WORKDIR}/{wildcards.sample}/rna_bbduk/{wildcards.sample}_stats.linker1.txt \
            threads={resources.cpus_per_task} \
            literal=GTGGCCGATGTTTCGCATCGGCGTACGACT
            """

    rule rna_filter_L2:
        input:
            in1 = WORKDIR + "/{sample}/tmp/rna_processed/{sample}_R1_filtered_linker1.fastq.gz",
            in2 = WORKDIR + "/{sample}/tmp/rna_processed/{sample}_R2_filtered_linker1.fastq.gz",
        output:
            out1 = WORKDIR + "/{sample}/tmp/rna_processed/{sample}_R1_filtered_linker2.fastq",
            out2 = WORKDIR + "/{sample}/tmp/rna_processed/{sample}_R2_filtered_linker2.fastq.gz",
        resources:
            mem = "20G",
            time = "12:00:00",
            cpus_per_task = 12,
        shell:
            """
            {bbduk} \
            in1={input.in1} in2={input.in2} \
            outm1={output.out1} outm2={output.out2} \
            k=30 mm=f rcomp=f restrictleft=70 skipr1=t hdist=3 \
            stats={WORKDIR}/{wildcards.sample}/rna_bbduk/{wildcards.sample}_stats.linker2.txt \
            threads={resources.cpus_per_task} \
            literal=ATCCACGTGCTTGAGAGGCCAGAGCATTCG
            """

    # Extract barcode+UMI from fixed positions in R2 for Spatial-DMT RNA.
    rule rna_fq_process:
        input:
            WORKDIR + "/{sample}/tmp/rna_processed/{sample}_R2_filtered_linker2.fastq.gz",
        output:
            WORKDIR + "/{sample}/tmp/rna_processed/{sample}_R2_processed.fastq",
        resources:
            mem = "8G",
            time = "4:00:00",
            cpus_per_task = 1,
        shell:
            """
            {PYTHON} {workflow.basedir}/../tools/fastq_process.py --input {input} --output {output}
            """

# Align RNA reads and quantify gene expression per spatial barcode using STARsolo
rule rna_star_solo:
    input:
        read_BC  = WORKDIR + "/{sample}/tmp/rna_processed/{sample}_R2_processed.fastq",
        read_Seq = WORKDIR + "/{sample}/tmp/rna_processed/{sample}_R1_filtered_linker2.fastq",
        wl       = RNA_STAR_WHITELIST,
    output:
        sam           = WORKDIR + "/{sample}/rna_STAR/Aligned.out.sam",
        log           = WORKDIR + "/{sample}/rna_STAR/Log.final.out",
        barcode_stats = WORKDIR + "/{sample}/rna_STAR/Solo.out/Barcodes.stats",
        raw_matrix    = WORKDIR + "/{sample}/rna_STAR/Solo.out/GeneFull/raw/matrix.mtx",
        raw_barcodes  = WORKDIR + "/{sample}/rna_STAR/Solo.out/GeneFull/raw/barcodes.tsv",
        summary       = WORKDIR + "/{sample}/rna_STAR/Solo.out/GeneFull/Summary.csv",
    resources:
        mem = "100G",
        time = "24:00:00",
        cpus_per_task = 24,
    shell:
        """
        if command -v module >/dev/null 2>&1; then module load STAR || true; fi
        mkdir -p {WORKDIR}/{wildcards.sample}/rna_STAR/
        STAR --runThreadN {resources.cpus_per_task} \
            --genomeDir {STAR_REF_DIR} \
            --readFilesIn {input.read_Seq} {input.read_BC} \
            --soloType CB_UMI_Simple \
            --soloCBwhitelist {input.wl} \
            --soloFeatures GeneFull \
            --outFileNamePrefix {WORKDIR}/{wildcards.sample}/rna_STAR/

        """

################################################################################
# QC Rules
# Run after preprocessing: snakemake --profile profiles/local_HPC -- qc
################################################################################

## Sample-level BISCUIT-QC on the merged dedup BAM (one invocation per sample,
## not ~9216 per-cell). Emits mapq/strand/dup tables + CpH/CpG retention-by-
## read-position. Does NOT pileup -- conversion table comes from dna_biscuit_
## pileup's already-existing per-cell VCFs (one pileup per cell, not a second
## sample-level one). covdist/cv intentionally not produced -- see
## spatialmeth_qc.sh header note on contig mismatch.
##
## Assumes biscuit >= 1.8 is on PATH (covdist/cv removal aside, the bare
## `biscuit qc` subcommand we depend on landed in 1.8; the conda recipe in
## README pins this). Same for the other biscuit-calling rules in this file.
rule mqc_biscuit:
    input:
        bam = DNA_QC_MERGED_BAM,
    output:
        mapq = WORKDIR + "/{sample}/qc/biscuit_qc/{sample}_mapq_table.txt",
    resources:
        mem = "12G",
        time = "4:00:00",
        cpus_per_task = 2,
    params:
        ref_fasta = os.path.join(REF_DIR, ref["REF_BASE"], ref["REF_FASTA"]),
        assets    = os.path.join(REF_DIR, ref["REF_BASE"], ref["BISCUIT_QCASSET"]),
        outdir    = WORKDIR + "/{sample}/qc/biscuit_qc",
    shell:
        """
        set -xe
        mkdir -p {params.outdir}

        ## No --vcf arg -> spatialmeth_qc.sh skips the conversion-table awk;
        ## that table is emitted by dna_biscuit_pileup from the per-cell VCFs.
        {workflow.basedir}/../tools/spatialmeth_qc.sh \
            -o {params.outdir} \
            {params.assets} {params.ref_fasta} {wildcards.sample} {input.bam}
        """


## Standard BISCUIT-QC on the unmatched (structure-fail + WL-miss) BAM as ONE
## "sample" -- becomes one entry in MultiQC, parallel to (not mixed with) the
## per-cell mqc_biscuit entries. Sees the whole unmatched bucket lumped together.
rule mqc_unmatched_biscuit:
    input:
        bam = WORKDIR + "/{sample}/bam_unmatched/{sample}_unmatched.bam",
    output:
        flag = WORKDIR + "/{sample}/qc/biscuit_qc_unmatched/.done",
    resources:
        mem = "16G",
        time = "8:00:00",
        cpus_per_task = 4,
    params:
        ref_fasta = os.path.join(REF_DIR, ref["REF_BASE"], ref["REF_FASTA"]),
        assets    = os.path.join(REF_DIR, ref["REF_BASE"], ref["BISCUIT_QCASSET"]),
    shell:
        """
        set -xeo pipefail
        mkdir -p {WORKDIR}/{wildcards.sample}/qc/biscuit_qc_unmatched/

        QC={workflow.basedir}/../tools/spatialmeth_qc.sh
        $QC -o {WORKDIR}/{wildcards.sample}/qc/biscuit_qc_unmatched/ \
            {params.assets} \
            {params.ref_fasta} \
            {wildcards.sample}_UNMATCHED \
            {input.bam}
        touch {output.flag}
        """


## Diagnose the unmatched bucket. Emits two files:
##   - tsv: long-format raw breakdown (section, key, value) for human/scripts
##   - mqc_summary: single MultiQC custom-content table -- per-sample row with
##     SF/WM reads + mapping rates AND SF anchor-fail breakdown counts
## The _mqc.tsv lands under qc/biscuit_qc_merged/ which the qc_report rule's
## multiqc invocation scans -- it automatically appears in the report.
rule mqc_unmatched_diagnostics:
    input:
        bam      = WORKDIR + "/{sample}/bam_unmatched/{sample}_unmatched.bam",
        r2_fastq = WORKDIR + "/{sample}/trim/{sample}_Unmatched_R2.fq.gz",
    output:
        tsv         = WORKDIR + "/{sample}/qc/unmatched_diagnostics.tsv",
        mqc_summary = WORKDIR + "/{sample}/qc/biscuit_qc_merged/{sample}_unmatched_summary_mqc.tsv",
    resources:
        mem = "8G",
        time = "4:00:00",
        cpus_per_task = 24,
    shell:
        """
        set -xeo pipefail
        mkdir -p {WORKDIR}/{wildcards.sample}/qc/biscuit_qc_merged/
        {PYTHON} {workflow.basedir}/../tools/unmatched_diagnostics.py \
            --bam {input.bam} \
            --r2-fastq {input.r2_fastq} \
            --protocol {PROTOCOL} \
            --sample {wildcards.sample} \
            --out {output.tsv} \
            --mqc-summary {output.mqc_summary} \
            --threads {resources.cpus_per_task}
        """

## Sample-level curated metrics table -- the canonical sample-row in MultiQC.
## Pulls from: pre-filter merged BAM flagstat (reads, mapped), the QC BAM
## flagstat (post-bsconv for smcseq), dupsifter.stat (dup_rate),
## sample-level biscuit qc on merged BAM (CA/CC/CT conversion), yame summary on
## {sample}.cg (cpg_coverage, cpg_depth, cpg_meth), lambda align/pileup (lambda
## mapped, lambda methylation retention). Emits a custom-content _mqc.tsv with
## per-column tooltip descriptions (YAML header) that MultiQC picks up under
## qc/biscuit_qc_merged/, alongside the unmatched diagnostic _mqc.
rule mqc_curated:
    input:
        merged_bam       = DNA_QC_MERGED_BAM,
        merged_flagstat  = DNA_QC_MERGED_FLAGSTAT,
        pre_filter_flagstat = WORKDIR + "/{sample}/bam_merged/{sample}_merged_dedup.bam.flagstat",
        merged_dupstat   = WORKDIR + "/{sample}/bam_merged/{sample}_merged_dedup.dupsifter.stat",
        biscuit_conv     = WORKDIR + "/{sample}/qc/biscuit_qc/{sample}_totalBaseConversionRate.txt",
        cg               = WORKDIR + "/{sample}/pileup/{sample}.cg",
        lambda_flagstat  = WORKDIR + "/{sample}/bam_lambda/{sample}_Lambda.bam.flagstat",
        lambda_cg        = WORKDIR + "/{sample}/pileup/{sample}_Lambda.cg",
    output:
        mqc = WORKDIR + "/{sample}/qc/biscuit_qc_merged/{sample}_curated_metrics_mqc.tsv",
    resources:
        mem = "4G",
        time = "1:00:00",
        cpus_per_task = 1,
    params:
        bsconv_log_arg = lambda wc: (
            f"--bsconv-log {WORKDIR}/{wc.sample}/bam_merged/{wc.sample}.bsconv.log"
            if PROTOCOL == "smcseq"
            else ""
        ),
    shell:
        """
        {PYTHON} {workflow.basedir}/../tools/write_curated_metrics_mqc.py \
            --sample           {wildcards.sample} \
            --merged-flagstat  {input.merged_flagstat} \
            --pre-filter-flagstat {input.pre_filter_flagstat} \
            {params.bsconv_log_arg} \
            --merged-dupstat   {input.merged_dupstat} \
            --biscuit-conv     {input.biscuit_conv} \
            --cg               {input.cg} \
            --lambda-flagstat  {input.lambda_flagstat} \
            --lambda-cg        {input.lambda_cg} \
            --output           {output.mqc}
        """

FEATURE_DIR    = os.path.join(REF_DIR, GENOME_FOR_PATH, "features")
FEATURE_CM_DIR = os.path.join(REF_DIR, GENOME_FOR_PATH, f"KYCGKB_{GENOME_FOR_PATH}")
CHROMHMM_CM    = os.path.join(REF_DIR, ref["REF_BASE"], ref["CHROMHMM_CM"])
if GENOME_FOR_PATH == "hg38":
    FEATS = ["ChromHMM.20220303", "Win100k.20220228", "Chromosome.20221129"]
else:
    FEATS = ["ChromHMM.20220414", "Win100k.20220228", "Win1m.20230709", "Chromosome.20221129"]

