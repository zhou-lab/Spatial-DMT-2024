        cp {input.cg_idx} {output.cg_idx}
        cp {input.lambda_cg} {output.lambda_cg}
        cp {input.qc} {output.qc}
        cp {input.multiqc} {output.multiqc}
        rm -rf {output.multiqc_data}
        cp -r {input.multiqc_data} {output.multiqc_data}
        """

